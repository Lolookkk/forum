PORT=5000
# Supabase Connection Pooling (Recommandé - supporte IPv4 et IPv6, port 5432 mode Session) :
# DATABASE_URL=postgresql://postgres.[TON_PROJET]:[TON_MOT_DE_PASSE]@aws-0-[TON_REGION].pooler.supabase.com:5432/postgres
#
# Supabase Connexion Directe (IPv6 uniquement) :
# DATABASE_URL=postgresql://postgres:[TON_MOT_DE_PASSE]@db.[TON_PROJET].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.[TON_PROJET]:[TON_MOT_DE_PASSE]@aws-0-eu-north-1.pooler.supabase.com:5432/postgres
JWT_SECRET=[TON_SECRET_JWT]
